DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5432/resolveai
AGENT_DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5432/resolveai_agent
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
COMMERCE_BASE_URL=http://localhost:8001
DEEPSEEK_BASE_URL=https://api.deepseek.com
